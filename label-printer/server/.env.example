# --- Shopify (from your app in the Dev Dashboard) ---
SHOPIFY_API_KEY=your-client-id
SHOPIFY_API_SECRET=your-client-secret
# Only these shops may print (comma-separated). Leave empty to allow any shop that installs the app.
ALLOWED_SHOPS=your-store.myshopify.com

# Public HTTPS URL of this server (used to show the Weblink address in the app)
PUBLIC_URL=https://labels.example.com

# --- Printers ---
# Name=token pairs separated by ";". Generate a token with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# The printer connects to  https://<PUBLIC_URL host>/weblink/<token>
PRINTERS=Front counter=REPLACE_WITH_RANDOM_TOKEN

# Used only until the printer reports its own resolution (203 or 300).
PRINTER_DPI=203

# --- Label ---
LABEL_WIDTH_IN=2
LABEL_HEIGHT_IN=1
LABEL_MARGIN_IN=0.06
# Barcodes: vendor UPC/EAN from the variant's Barcode field, else the SKU as Code 128
BARCODES=true
# auto = print the product name when there's room (2" x 1.5" yes, 2" x 1" no); false = never
SHOW_PRODUCT_TITLE=auto
PRICE_LOCALE=en-US

# Logo: PNG, black on white/transparent works best. Set LOGO_PATH= (empty) for no logo.
LOGO_PATH=assets/logo.png
LOGO_MAX_WIDTH=0.7
LOGO_ALIGN=left
LOGO_THRESHOLD=128
# Turn on for photo-like logos with gradients
LOGO_DITHER=false

MAX_LABELS_PER_JOB=1000

# --- Optional: terminate TLS in this process instead of at your host's proxy ---
# TLS_CERT_FILE=/etc/certs/fullchain.pem
# TLS_KEY_FILE=/etc/certs/privkey.pem
